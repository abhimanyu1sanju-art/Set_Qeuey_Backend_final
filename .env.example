# ─── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_PREFIX=/api

# ─── MongoDB — fill in your URI before running ────────────────────────────────
MONGODB_URI=
DATABASE_NAME=satquery

# ─── CORS — comma-separated origins ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Phase 2 — Image Storage ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
THUMBNAIL_SIZE=512

# ─── Phase 4 — AI Provider ────────────────────────────────────────────────────
# SECURITY: AI_API_KEY must NEVER be committed or sent to the frontend.
# The application starts without this value but returns HTTP 503 on
# analysis requests until it is configured.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=60

# ─── Phase 1 — Copernicus Data Space (Satellite Data) ─────────────────────────
# STAC metadata search is public — no credentials required.
# Credentials are only needed for band/asset download (Phase 2+).
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ─── Phase 2 — Real Spectral Analysis (Sentinel-2 Band Download) ──────────────
# SECURITY: COPERNICUS_CLIENT_ID and COPERNICUS_CLIENT_SECRET must NEVER be
# committed to version control or sent to the frontend.
# The backend returns HTTP 503 (not mock data) if these are not configured.
#
# How to obtain:
#   1. Register at https://dataspace.copernicus.eu/ (free account)
#   2. Go to your profile → OAuth Clients → Create new client
#   3. Copy the client_id and client_secret here
#   4. Grant type: Client Credentials
#
# These are the same variables used for Phase 1 STAC metadata access.
# Phase 1 works without them (public STAC). Phase 2 requires them.

# CDSE OAuth2 token endpoint -- do not change unless CDSE updates their URL
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Directory for spectral GeoTIFF outputs (relative to backend working directory)
SPECTRAL_OUTPUT_DIR=outputs/spectral

# --- Phase 2 -- Copernicus S3 Band Access (real raster reads) ----------------
# SECURITY: CDSE_S3_ACCESS_KEY and CDSE_S3_SECRET_KEY must NEVER be committed
# to version control. They belong ONLY in your local .env file (which is
# listed in .gitignore). This .env.example file is committed -- leave values blank.
#
# How to obtain:
#   1. Log in at https://dataspace.copernicus.eu/
#   2. Go to Profile -> User Settings -> S3 Credentials
#   3. Click "Generate new credentials"
#   4. Copy the Access Key and Secret Key into your LOCAL .env file ONLY.
#
# Used by Phase 2 spectral analysis to read Sentinel-2 band JP2 files
# via GDAL /vsis3/ virtual filesystem without downloading full products.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu